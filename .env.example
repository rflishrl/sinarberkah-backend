# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Neon PostgreSQL -----------------------------------------------------------
# Neon database connection string (obtain from neon.tech or Vercel Marketplace).
# Either DATABASE_URI or DATABASE_URL is accepted.
DATABASE_URI="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret string used to sign HMAC-SHA256 session cookies (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Photos (Vercel Blob) ------------------------------------------------------
# Vercel Blob read-write token for photo uploads.
# Automatically provided in Vercel when connecting a Blob store.
BLOB_READ_WRITE_TOKEN=""

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
# Leave empty if the frontend only calls the API from the server (Server Components).
ALLOWED_ORIGINS="http://localhost:3000"

# Instant cache revalidation on the frontend after admin edits:
# FRONTEND_URL: the address of the frontend application.
# REVALIDATE_SECRET: shared secret matching the frontend REVALIDATE_SECRET.
FRONTEND_URL="http://localhost:3000"
REVALIDATE_SECRET=""

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
# Vercel sends it automatically in the Authorization header. Empty = cron is off.
CRON_SECRET=""
