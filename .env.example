# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Supabase ------------------------------------------------------------------
# All values are read on the server only, so none of them use the NEXT_PUBLIC_ prefix.
# Supabase > Connect button: Project URL and Publishable key.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# Supabase > Settings > API Keys > Secret key. SECRET: it bypasses RLS.
# Used only for rate limiting, the photo cleanup cron, and the create-admin script.
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Only for local commands (npm run db:push / db:types). Not needed on Vercel.
# Supabase > Connect > Direct > Session pooler (IPv4). Replace [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Only for the one-time data copy (npm run db:copy-from-neon). Delete it afterwards.
# Production Neon connection string (Vercel > backend project > Settings > Environment Variables > DATABASE_URL).
NEON_DATABASE_URL=

# --- Photos --------------------------------------------------------------------
# Vercel Blob token for photo uploads.
# Vercel Dashboard > Storage > Blob > (create a store) > .env.local > BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
# Leave empty if the frontend only calls the API from the server (Server Components).
ALLOWED_ORIGINS=http://localhost:3000

# Makes admin changes show up on the frontend right away (without waiting for the 1-hour cache):
# FRONTEND_URL = the frontend site address. REVALIDATE_SECRET must match the one in the frontend.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If either one is empty, this feature is off and nothing breaks.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
# Vercel sends it automatically in the Authorization header. Empty = the cron endpoint is off.
CRON_SECRET=
