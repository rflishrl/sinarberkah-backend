# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Database & Auth (Neon PostgreSQL) ------------------------------------------
# Neon database connection string (obtain from neon.tech or Vercel Marketplace).
DATABASE_URI=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret string used to sign HMAC-SHA256 session cookies (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Photos --------------------------------------------------------------------
# Vercel Blob token for photo uploads.
# Automatically set in Vercel when connecting a Blob store.
BLOB_READ_WRITE_TOKEN=

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
# Leave empty if the frontend only calls the API from the server (Server Components).
ALLOWED_ORIGINS=http://localhost:3000

# Makes admin changes show up on the frontend right away (without waiting for cache):
# FRONTEND_URL = the frontend site address. REVALIDATE_SECRET must match the one in the frontend.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
# Vercel sends it automatically in the Authorization header. Empty = the cron endpoint is off.
CRON_SECRET=
