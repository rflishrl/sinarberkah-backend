# Salin file ini menjadi `.env.local`, lalu isi nilainya. Jangan commit `.env.local`.

# Connection string PostgreSQL.
# Nilai di bawah cocok dengan docker-compose.yml (npm run db:up) untuk pengembangan lokal.
# Untuk produksi pakai Neon / Vercel Postgres / Supabase (alamat "pooled", host mengandung -pooler):
#   DATABASE_URL=postgres://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgres://sinarberkah:sinarberkah_dev@localhost:5432/sinarberkah

# Token Vercel Blob untuk unggah foto.
# Vercel Dashboard > Storage > Blob > (buat store) > .env.local > BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# Rahasia untuk menandatangani sesi login. Minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Versi sesi. Ganti nilainya (mis. 1 -> 2) untuk mengeluarkan semua admin yang sedang login.
SESSION_VERSION=1

# Akun admin. Buat hash password dengan: npm run hash-password -- "password-anda"
ADMIN_EMAIL=admin@sinarberkah.local
ADMIN_PASSWORD_HASH=

# Alamat situs frontend yang boleh membaca API dari browser (CORS), pisahkan dengan koma.
# Kosongkan jika frontend hanya memanggil API dari server (Server Components).
ALLOWED_ORIGINS=http://localhost:3000

# Agar perubahan di admin langsung tampil di frontend (tanpa menunggu cache 1 jam):
# FRONTEND_URL = alamat situs frontend. REVALIDATE_SECRET harus sama dengan di frontend.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika salah satunya kosong, fitur ini mati dan tidak ada yang rusak.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=


# Rahasia untuk Vercel Cron (pembersihan foto yatim setiap hari, lihat vercel.json).
# Vercel mengirimnya otomatis di header Authorization. Kosong = endpoint cron mati.
CRON_SECRET=
