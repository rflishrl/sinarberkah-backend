# Copy this file to `.env.local`, then fill in the values. Never commit `.env.local`.

# --- Neon PostgreSQL -----------------------------------------------------------
# Neon database connection string (obtain from neon.tech or Vercel Marketplace).
# Either DATABASE_URI or DATABASE_URL is accepted.
DATABASE_URI="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret string used to sign HMAC-SHA256 session cookies (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Media Storage (Cloudflare R2) --------------------------------------------
# Cloudflare R2 S3-compatible credentials (scoped to the `sinar-berkah` bucket).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="sinar-berkah"
R2_PUBLIC_DOMAIN="https://media-sb.raflisahrul.my.id"

# Per-app R2 quota guard in MB (2560 MB = 2.5 GB) and upload limit in MB (max 4).
R2_APP_QUOTA_MB="2560"
MAX_UPLOAD_MB="4"

# --- Frontend ------------------------------------------------------------------
# Frontend origins allowed to read the API from the browser (CORS), separated by commas.
# Leave empty if the frontend only calls the API from the server (Server Components).
ALLOWED_ORIGINS="http://localhost:3000"

# Instant cache revalidation on the frontend after admin edits:
# FRONTEND_URL: the address of the frontend application.
# REVALIDATE_SECRET: shared secret matching the frontend REVALIDATE_SECRET.
FRONTEND_URL="http://localhost:3000"
REVALIDATE_SECRET=""

# --- Cron ----------------------------------------------------------------------
# Secret for Vercel Cron (daily cleanup of orphaned photos, see vercel.json).
# Vercel sends it automatically in the Authorization header. Empty = cron is off.
CRON_SECRET=""

# --- Cloudflare Turnstile ------------------------------------------------------
# Server secret key to verify tokens against Cloudflare Siteverify (server only).
# Testing dummy key (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Public site key for rendering Turnstile widget in the client browser.
# Testing dummy sitekey (always passes): 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Comma-separated list of hostnames allowed during Turnstile verification.
# Development: localhost,127.0.0.1
# Production: your production domain(s)
TURNSTILE_ALLOWED_HOSTNAMES="localhost,127.0.0.1"
